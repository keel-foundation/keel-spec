{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keel:schema:enforcement-action:0.1",
  "title": "Enforcement Action",
  "description": "A human-reviewed decision that restricts a video, channel, account, or instance. The Statement of Reasons is mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "case_id",
    "action_type",
    "scope",
    "policy_clause",
    "statement_of_reasons",
    "human_reviewer",
    "status",
    "effective_at",
    "appeal_deadline",
    "audit_record_hash",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^act_[a-zA-Z0-9]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case_[a-zA-Z0-9]+$"
    },
    "action_type": {
      "type": "string",
      "enum": ["warn", "remove", "age_restrict", "demonetize", "suspend", "terminate", "label", "downrank"]
    },
    "scope": {
      "type": "string",
      "enum": ["video", "channel", "account", "instance"]
    },
    "policy_clause": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "The exact policy clause relied upon."
    },
    "statement_of_reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "policy_version", "evidence_refs"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string"
          }
        },
        "reviewer_note": {
          "type": "string"
        }
      }
    },
    "human_reviewer": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "reversed", "expired"]
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "appeal_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "appeal_url": {
      "type": "string",
      "format": "uri"
    },
    "audit_record_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reversal_record_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
