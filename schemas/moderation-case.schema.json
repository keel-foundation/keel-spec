{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keel:schema:moderation-case:0.1",
  "title": "Moderation Case",
  "description": "A review unit that groups signals and evidence about a video, channel, account, or instance. A case is not a decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "status",
    "severity",
    "policy_refs",
    "signals",
    "evidence",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^case_[a-zA-Z0-9]+$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["video", "channel", "account", "instance"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["open", "reviewing", "decided", "appealed", "closed"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "signal_type", "created_at"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sig_[a-zA-Z0-9]+$"
          },
          "source": {
            "type": "string",
            "enum": ["automated", "user_report", "priority_flagger", "instance", "court_order"]
          },
          "signal_type": {
            "type": "string",
            "enum": [
              "spam",
              "scam",
              "piracy",
              "impersonation",
              "harassment",
              "csam",
              "copyright",
              "terrorism",
              "other"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "model_version": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["video", "timestamp", "transcript", "metadata", "model_output", "user_report", "legal_order", "other"]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "assignee": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "decision_action_id": {
      "type": "string",
      "pattern": "^act_[a-zA-Z0-9]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
